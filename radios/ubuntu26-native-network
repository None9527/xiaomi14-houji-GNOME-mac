def paths(values=()):
    return dbus.Array([O(v) for v in values], signature='o')

def error(message, suffix='NotSupported', domain=NM):
    e = dbus.DBusException(message)
    e._dbus_error_name = domain + '.' + suffix
    return e

def bluez_error(message, suffix='Failed'):
    return error(message, suffix, BLUEZ + '.Error')

def android(request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(17)
        sock.connect('\0ubuntu26-native-network-agent')
        if struct.unpack('3i', sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))[1] != 0:
            raise error('Android agent has an unexpected UID', 'PermissionDenied')
        sock.sendall(json.dumps(request, ensure_ascii=False).encode() + b'\n')
        with sock.makefile('rb') as stream:
            reply = json.loads(stream.readline(1024 * 1024))
        if not reply.get('ok'):
            raise error('Android rejected operation: ' + reply.get('error', 'unknown'), 'Failed')
        return reply['data']

class Object(dbus.service.Object):
    """An exported object; `manager` is the ObjectManager that lists it
    (NetworkManager's by default, False for none)."""

    def __init__(self, service, path, interfaces, manager=None):
        self.service, self.path, self.interfaces = service, path, interfaces
        self.manager = service.manager if manager is None else manager
        # (interface, property) -> callable(value) for writable properties.
        self.setters = {}
        super().__init__(service.bus, path)
        service.objects[path] = self
        if self.manager:
            self.manager.objects[path] = self
            self.manager.InterfacesAdded(O(path), interfaces)

    @dbus.service.method(PROP, in_signature='s', out_signature='a{sv}')
    def GetAll(self, iface):
        return self.interfaces.get(str(iface), {})

    @dbus.service.method(PROP, in_signature='ss', out_signature='v')
    def Get(self, iface, key):
        if str(key) not in self.interfaces.get(str(iface), {}):
            raise error('Unknown property', 'UnknownProperty')
        return self.interfaces[str(iface)][str(key)]

    @dbus.service.method(PROP, in_signature='ssv', out_signature='', sender_keyword='sender')
    def Set(self, iface, key, value, sender=None):
        self.service.authorize(sender)
        setter = self.setters.get((str(iface), str(key)))
        if not setter:
            raise error('Property is not writable')
        setter(value)

    @dbus.service.signal(PROP, signature='sa{sv}as')
    def PropertiesChanged(self, iface, changed, invalidated):
        pass

    def update(self, iface, changes):
        props = self.interfaces[iface]
        delta = {k: v for k, v in changes.items() if props.get(k) != v}
        if delta:
            props.update(delta)
            self.PropertiesChanged(iface, delta, [])

    def remove(self):
        if self.manager:
            self.manager.InterfacesRemoved(O(self.path), list(self.interfaces))
            self.manager.objects.pop(self.path, None)
        self.service.objects.pop(self.path, None)
        self.remove_from_connection()

class Manager(dbus.service.Object):
    def __init__(self, service, path='/org/freedesktop'):
        self.service = service
        self.objects = {}
        super().__init__(service.bus, path)

    @dbus.service.method(OM, in_signature='', out_signature='a{oa{sa{sv}}}')
    def GetManagedObjects(self):
        return {O(k): v.interfaces for k, v in self.objects.items()}

    @dbus.service.signal(OM, signature='oa{sa{sv}}')
    def InterfacesAdded(self, path, interfaces):
        pass

    @dbus.service.signal(OM, signature='oas')
    def InterfacesRemoved(self, path, interfaces):
        pass

class AccessPoint(Object):
    def __init__(self, service, ap):
        path = BASE + '/AccessPoint/a' + hashlib.sha256(ap['bssid'].encode()).hexdigest()[:16]
        super().__init__(service, path, {APIF: {}})
        self.refresh(ap)

    def refresh(self, ap):
        self.ap = ap
        caps = ap.get('capabilities', '')
        secure = any(x in caps for x in ('WPA', 'RSN', 'WEP', 'SAE', 'OWE'))
        flags = 0
        if 'PSK' in caps: flags |= 0x188
        if 'SAE' in caps: flags |= 0x488
        if 'EAP' in caps: flags |= 0x288
        if 'OWE' in caps: flags |= 0x888
        self.update(APIF, {
            'Ssid': dbus.ByteArray(ap['ssid'].encode()), 'HwAddress': S(ap['bssid']),
            'Strength': dbus.Byte(max(0, min(100, (ap['rssi'] + 100) * 2))),
            'Frequency': U(ap['frequency']), 'Flags': U(1 if secure else 0),
            'WpaFlags': U(flags if 'WPA-' in caps else 0), 'RsnFlags': U(flags if any(x in caps for x in ('RSN', 'WPA2', 'WPA3')) else 0),
            'Mode': U(2), 'MaxBitrate': U(0), 'LastSeen': dbus.Int32(int(time.monotonic())),
        })

class Profile(Object):
    def __init__(self, service, profile):
        self.profile = profile
        number = profile['networkId']
        path = BASE + '/Settings/' + str(number + 1)
        super().__init__(service, path, {CON: {'Unsaved': B(False), 'Flags': U(0), 'Filename': S('')}})

    def settings(self):
        p = self.profile
        value = {
            'connection': {'id': S(p['ssid']), 'uuid': S(str(uuid.uuid5(uuid.NAMESPACE_URL, 'android-wifi:' + str(p['networkId']) + ':' + p['ssid']))),
                           'type': S('802-11-wireless'), 'autoconnect': B(True)},
            '802-11-wireless': {'ssid': dbus.ByteArray(p['ssid'].encode()), 'mode': S('infrastructure')},
            'ipv4': {'method': S('auto')}, 'ipv6': {'method': S('auto')},
        }
        keys = p.get('keyManagement', '')
        if keys != '{0}':
            value['802-11-wireless-security'] = {'key-mgmt': S('sae' if '8' in keys else 'wpa-psk'), 'psk-flags': U(1)}
        return value

    @dbus.service.method(CON, in_signature='', out_signature='a{sa{sv}}')
    def GetSettings(self):
        return self.settings()

    @dbus.service.method(CON, in_signature='s', out_signature='a{sa{sv}}', sender_keyword='sender')
    def GetSecrets(self, setting, sender=None):
        self.service.authorize(sender)
        raise error('Saved passwords remain in Android', 'Settings.Connection.SecretsUnavailable')

    @dbus.service.method(CON, in_signature='', out_signature='', sender_keyword='sender')
    def Delete(self, sender=None):
        self.service.authorize(sender)
        raise error('Forget networks in Android settings for now')

class PendingProfile(Profile):
    def __init__(self, service, settings):
        self.value = settings
        self.profile = {'networkId': -1, 'ssid': bytes(settings['802-11-wireless']['ssid']).decode()}
        path = BASE + '/Settings/pending' + uuid.uuid4().hex
        Object.__init__(self, service, path, {CON: {'Unsaved': B(True), 'Flags': U(2), 'Filename': S('')}})

    def settings(self):
        return self.value

