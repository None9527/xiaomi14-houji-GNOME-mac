class AgentManager(Object):
    def __init__(self, service):
        super().__init__(service, BASE + '/AgentManager', {NM + '.AgentManager': {}})
        self.agents = {}

    @dbus.service.method(NM + '.AgentManager', in_signature='s', out_signature='', sender_keyword='sender')
    def Register(self, identifier, sender=None):
        self.RegisterWithCapabilities(identifier, 0, sender)

    @dbus.service.method(NM + '.AgentManager', in_signature='su', out_signature='', sender_keyword='sender')
    def RegisterWithCapabilities(self, identifier, caps, sender=None):
        self.service.authorize(sender)
        self.agents[str(sender)] = self.service.bus.get_object(sender, BASE + '/SecretAgent', introspect=False)

    @dbus.service.method(NM + '.AgentManager', in_signature='', out_signature='', sender_keyword='sender')
    def Unregister(self, sender=None):
        self.agents.pop(str(sender), None)

class NetworkManager(Object):
    def __init__(self, service):
        super().__init__(service, BASE, {NM: {
            'Version': S('1.54.3'), 'VersionInfo': dbus.Array([U(0x013603)], signature='u'),
            'State': U(20), 'Startup': B(False), 'NetworkingEnabled': B(True),
            'WirelessEnabled': B(True), 'WirelessHardwareEnabled': B(True),
            'WwanEnabled': B(False), 'WwanHardwareEnabled': B(False),
            'Devices': paths([DEV, MODEM_DEV]), 'AllDevices': paths([DEV, MODEM_DEV]), 'ActiveConnections': paths(),
            'PrimaryConnection': O('/'), 'ActivatingConnection': O('/'), 'PrimaryConnectionType': S(''),
            'Connectivity': U(1), 'Metered': U(0), 'Capabilities': dbus.Array([], signature='u'),
        }})
        self.setters[(NM, 'WirelessEnabled')] = lambda value: service.control(
            {'action': 'wifi', 'enabled': bool(value)})
        self.setters[(NM, 'WwanEnabled')] = lambda value: service.control(
            {'action': 'mobile-data', 'enabled': bool(value)})

    @dbus.service.method(NM, in_signature='', out_signature='ao')
    def GetDevices(self): return paths([DEV, MODEM_DEV])

    @dbus.service.method(NM, in_signature='', out_signature='ao')
    def GetAllDevices(self): return paths([DEV, MODEM_DEV])

    @dbus.service.method(NM, in_signature='', out_signature='a{ss}')
    def GetPermissions(self):
        return {NM.lower() + '.' + p: 'yes' for p in ('enable-disable-wifi', 'network-control', 'wifi.scan')}

    @dbus.service.method(NM, in_signature='', out_signature='u')
    def CheckConnectivity(self): return self.interfaces[NM]['Connectivity']

    @dbus.service.method(NM, in_signature='ooo', out_signature='o', sender_keyword='sender', async_callbacks=('done','fail'))
    def ActivateConnection(self, connection, device, specific, done, fail, sender=None):
        self.service.authorize(sender)
        if str(connection) == MOBILE_PROFILE:
            self.service.request({'action': 'mobile-data', 'enabled': True},
                                 lambda result: done(O(MOBILE_ACTIVE)), fail)
            return
        if str(device) != DEV or str(connection) not in self.service.profiles:
            fail(error('Unknown device or profile', 'UnknownConnection'))
            return
        profile = self.service.profiles[str(connection)]
        self.service.connect({'action':'connect','networkId':profile.profile['networkId']}, profile, done, fail)

    @dbus.service.method(NM, in_signature='a{sa{sv}}oo', out_signature='oo', sender_keyword='sender', async_callbacks=('done','fail'))
    def AddAndActivateConnection(self, settings, device, specific, done, fail, sender=None):
        self.service.authorize(sender)
        self.service.add_activate(settings, device, lambda cp, ac: done(cp, ac), fail)

    @dbus.service.method(NM, in_signature='a{sa{sv}}ooa{sv}', out_signature='ooa{sv}', sender_keyword='sender', async_callbacks=('done','fail'))
    def AddAndActivateConnection2(self, settings, device, specific, options, done, fail, sender=None):
        self.service.authorize(sender)
        if options:
            fail(error('Connection options are not supported'))
            return
        self.service.add_activate(settings, device, lambda cp, ac: done(cp, ac, dbus.Dictionary({},signature='sv')), fail)

    @dbus.service.method(NM, in_signature='o', out_signature='', sender_keyword='sender', async_callbacks=('done','fail'))
    def DeactivateConnection(self, connection, done, fail, sender=None):
        self.service.authorize(sender)
        if str(connection) == MOBILE_ACTIVE:
            self.service.request({'action': 'mobile-data', 'enabled': False}, lambda result: done(), fail)
            return
        if str(connection) != self.service.active_path:
            fail(error('Unknown active connection'))
            return
        self.service.request({'action':'disconnect'}, lambda result: done(), fail)

    @dbus.service.signal(NM, signature='u')
    def StateChanged(self, state): pass

