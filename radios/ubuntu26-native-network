def bluetooth_icon(device_class):
    major, minor = (device_class >> 8) & 0x1f, (device_class >> 2) & 0x3f
    if major == 0x01: return 'computer'
    if major == 0x02: return 'phone'
    if major == 0x04:
        return {0x01: 'audio-headset', 0x02: 'audio-headset', 0x06: 'audio-headphones',
                0x08: 'audio-card', 0x0b: 'video-display', 0x0c: 'camera-video'}.get(minor, 'audio-card')
    if major == 0x05:
        if minor & 0x10: return 'input-keyboard'
        if minor & 0x20: return 'input-mouse'
        return 'input-gaming' if (minor & 0x0f) in (0x01, 0x02) else 'input-tablet'
    if major == 0x06: return 'printer' if minor & 0x20 else 'camera-photo'
    return 'bluetooth'

def bluetooth_path(address):
    return ADAPTER_PATH + '/dev_' + address.upper().replace(':', '_')

