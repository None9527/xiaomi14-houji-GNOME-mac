class Adapter(Object):
    def __init__(self, service):
        super().__init__(service, ADAPTER_PATH, {ADAPTER: {
            'Address': S('00:00:00:00:00:00'), 'AddressType': S('public'), 'Name': S('Android'),
            'Alias': S('Android'), 'Class': U(0x5a020c), 'Powered': B(False), 'PowerState': S('off'),
            'Discoverable': B(False), 'DiscoverableTimeout': U(180), 'Pairable': B(False),
            'PairableTimeout': U(0), 'Discovering': B(False), 'UUIDs': dbus.Array([], signature='s'),
            'Modalias': S(''), 'Roles': dbus.Array(['central', 'peripheral'], signature='s'),
        }}, service.bluez_manager)
        self.setters[(ADAPTER, 'Powered')] = lambda value: service.control(
            {'action': 'bluetooth', 'enabled': bool(value)})
        self.setters[(ADAPTER, 'Alias')] = lambda value: service.control(
            {'action': 'bluetooth-name', 'name': str(value)})
        self.setters[(ADAPTER, 'Discoverable')] = self._refuse_discovery
        self.setters[(ADAPTER, 'Pairable')] = self._refuse_discovery

    def _refuse_discovery(self, value):
        if value:
            raise bluez_error('Pair new devices in the phone\'s Bluetooth settings', 'NotSupported')

    @dbus.service.method(ADAPTER, in_signature='', out_signature='')
    def StartDiscovery(self):
        raise bluez_error('Pair new devices in the phone\'s Bluetooth settings', 'NotSupported')

    @dbus.service.method(ADAPTER, in_signature='', out_signature='')
    def StopDiscovery(self): pass

    @dbus.service.method(ADAPTER, in_signature='a{sv}', out_signature='')
    def SetDiscoveryFilter(self, properties): pass

    @dbus.service.method(ADAPTER, in_signature='', out_signature='as')
    def GetDiscoveryFilters(self): return dbus.Array([], signature='s')

    @dbus.service.method(ADAPTER, in_signature='o', out_signature='', sender_keyword='sender', async_callbacks=('done','fail'))
    def RemoveDevice(self, path, done, fail, sender=None):
        self.service.authorize(sender)
        device = self.service.bt_devices.get(str(path))
        if not device:
            fail(bluez_error('Unknown device', 'DoesNotExist'))
            return
        self.service.request({'action': 'bluetooth-forget', 'address': device.address},
                             lambda result: done(), fail)

class BluetoothDevice(Object):
    def __init__(self, service, address):
        self.address = address
        super().__init__(service, bluetooth_path(address), {BT_DEVICE: {
            'Address': S(address), 'AddressType': S('public'), 'Name': S(address), 'Alias': S(address),
            'Class': U(0), 'Icon': S('bluetooth'), 'Paired': B(True), 'Bonded': B(True), 'Trusted': B(True),
            'Blocked': B(False), 'LegacyPairing': B(False), 'Connected': B(False), 'ServicesResolved': B(False),
            'UUIDs': dbus.Array([], signature='s'), 'Adapter': O(ADAPTER_PATH), 'WakeAllowed': B(False),
        }}, service.bluez_manager)

    def refresh(self, entry):
        name = entry.get('name') or self.address
        device_class = int(entry.get('class') or 0)
        connected = bool(entry.get('connected'))
        self.update(BT_DEVICE, {'Name': S(name), 'Alias': S(entry.get('alias') or name),
                                'Class': U(device_class), 'Icon': S(bluetooth_icon(device_class)),
                                'Connected': B(connected), 'ServicesResolved': B(connected)})

    def _set_connected(self, connected, done, fail):
        self.service.request({'action': 'bluetooth-connect', 'address': self.address, 'connected': connected},
                             lambda result: done(), fail)

    @dbus.service.method(BT_DEVICE, in_signature='', out_signature='', sender_keyword='sender', async_callbacks=('done','fail'))
    def Connect(self, done, fail, sender=None):
        self.service.authorize(sender)
        self._set_connected(True, done, fail)

    @dbus.service.method(BT_DEVICE, in_signature='', out_signature='', sender_keyword='sender', async_callbacks=('done','fail'))
    def Disconnect(self, done, fail, sender=None):
        self.service.authorize(sender)
        self._set_connected(False, done, fail)

    @dbus.service.method(BT_DEVICE, in_signature='s', out_signature='', sender_keyword='sender', async_callbacks=('done','fail'))
    def ConnectProfile(self, profile, done, fail, sender=None):
        self.service.authorize(sender)
        self._set_connected(True, done, fail)

    @dbus.service.method(BT_DEVICE, in_signature='s', out_signature='', sender_keyword='sender', async_callbacks=('done','fail'))
    def DisconnectProfile(self, profile, done, fail, sender=None):
        self.service.authorize(sender)
        self._set_connected(False, done, fail)

    @dbus.service.method(BT_DEVICE, in_signature='', out_signature='')
    def Pair(self):
        raise bluez_error('Already paired', 'AlreadyExists')

    @dbus.service.method(BT_DEVICE, in_signature='', out_signature='')
    def CancelPairing(self): pass

