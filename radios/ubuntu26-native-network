# --- Panel shape ---------------------------------------------------------

class Screen(Object):
    """The phone panel's shape in its current rotation (physical pixels), so
    the desktop can keep its chrome clear of the cutout and rounded corners."""

    def __init__(self, service):
        super().__init__(service, SCREEN_PATH, {SCREEN: {
            'Rotation': U(0), 'Width': U(0), 'Height': U(0),
            'SafeInsets': dbus.Struct((dbus.Int32(0),) * 4, signature='iiii'),
            'Cutouts': dbus.Array([], signature='(iiii)'), 'CornerRadius': U(0),
        }}, False)

    def apply(self, data):
        self.update(SCREEN, {
            'Rotation': U(data['rotation']), 'Width': U(data['width']), 'Height': U(data['height']),
            'SafeInsets': dbus.Struct([dbus.Int32(v) for v in data['insets']], signature='iiii'),
            'Cutouts': dbus.Array([dbus.Struct([dbus.Int32(v) for v in r], signature='iiii')
                                   for r in data['cutouts']], signature='(iiii)'),
            'CornerRadius': U(data['cornerRadius']),
        })

    @dbus.service.method(SCREEN, in_signature='', out_signature='a{sv}', async_callbacks=('done', 'fail'))
    def Refresh(self, done, fail):
        """Reads the shape now (after a rotation) and returns the properties."""
        def received(data):
            self.apply(data)
            done(self.interfaces[SCREEN])
        self.service.request({'action': 'display'}, received, fail)

class Service:
    def __init__(self):
        self.bus = dbus.SystemBus()
        self.objects, self.aps, self.profiles = {}, {}, {}
        self.manager = None
        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
        self.polling = False
        self.active_path, self.active_profile = '/', None
        self.activation_started = 0
        self.pending = None
        self.manager = Manager(self)
        self.mm_manager = Manager(self, MM_BASE)
        self.bluez_manager = Manager(self, '/')
        self.root = NetworkManager(self)
        self.device = Device(self)
        self.modem_device = ModemDevice(self)
        self.settings = Settings(self)
        self.mobile_profile = MobileProfile(self)
        self.mobile_active = None
        self.agent = AgentManager(self)
        self.modem = Modem(self)
        self.bluez_root = BluezRoot(self)
        self.adapter = Adapter(self)
        self.bt_devices = {}
        self.radios = Radios(self)
        self.screen = Screen(self)
        self.refresh(android({'action':'snapshot'}))
        self.screen.apply(android({'action': 'display'}))
        self.names = [dbus.service.BusName(name, self.bus, do_not_queue=True)
                      for name in (NM, MM, BLUEZ, RADIOS, SCREEN)]
        GLib.timeout_add_seconds(3, self.poll)

    def authorize(self, sender):
        if sender is None or self.bus.get_unix_user(sender) not in (0, 60000):
            raise error('Only the local Ubuntu desktop may control radios', 'PermissionDenied')

    def control(self, request):
        """Fire-and-forget Android request for property setters."""
        self.request(request, fail=lambda exc: print('Android request failed:', request.get('action'),
                                                      getattr(exc, 'get_dbus_message', lambda: exc)(), flush=True))

    def request(self, request, done=None, fail=None):
        future = self.pool.submit(android, request)
        def completed(result):
            try:
                value = result.result()
                if 'accepted' in value and not value['accepted']:
                    raise error('Android did not accept operation', 'Failed')
            except Exception as exc:
                if fail: GLib.idle_add(lambda e=exc: (fail(e), False)[1])
            else:
                if done: GLib.idle_add(lambda: (done(value), False)[1])
            GLib.idle_add(lambda: (self.poll(), False)[1])
        future.add_done_callback(completed)

    def poll(self):
        if self.polling: return True
        self.polling = True
        future = self.pool.submit(android, {'action':'snapshot'})
        def completed(future):
            def apply():
                self.polling = False
                try: self.refresh(future.result())
                except Exception:
                    # Do not show stale connected state when the agent is unavailable.
                    self.device.update(DEVICE, {'State': U(20)})
                    self.root.update(NM, {'State': U(10), 'Connectivity': U(0)})
                return False
            GLib.idle_add(apply)
        future.add_done_callback(completed)
        return True

    def connect(self, request, profile, done, fail):
        def accepted(result):
            self.clear_active()
            self.active_profile = profile
            self.pending = profile.profile['ssid']
            self.activation_started = time.monotonic()
            self.set_active(profile, 1)
            done(O(self.active_path))
        self.request(request, accepted, fail)

    def add_activate(self, settings, device, done, fail):
        try:
            if str(device) != DEV: raise error('Unknown device')
            if settings.get('connection', {}).get('type', '802-11-wireless') != '802-11-wireless':
                raise error('Only Wi-Fi infrastructure connections are supported')
            wireless = settings.get('802-11-wireless', {})
            if wireless.get('mode', 'infrastructure') != 'infrastructure' or wireless.get('hidden', False):
                raise error('Hotspot, ad-hoc and hidden networks are not supported yet')
            for family in ('ipv4', 'ipv6'):
                if settings.get(family, {}).get('method', 'auto') != 'auto':
                    raise error('IP configuration is managed by Android')
            ssid = bytes(wireless['ssid']).decode('utf-8')
            security = settings.get('802-11-wireless-security', {})
            key = str(security.get('key-mgmt', 'none'))
            if key not in ('none', 'wpa-psk', 'sae'): raise error('This Wi-Fi security type is not supported yet')
            # Build a minimal profile, deliberately excluding any supplied password.
            cleaned = {'connection': {'id': S(ssid), 'uuid': S(str(uuid.uuid4())), 'type': S('802-11-wireless')},
                       '802-11-wireless': {'ssid': dbus.ByteArray(ssid.encode()), 'mode': S('infrastructure')},
                       'ipv4': {'method': S('auto')}, 'ipv6': {'method': S('auto')}}
            if key != 'none': cleaned['802-11-wireless-security'] = {'key-mgmt': S(key), 'psk-flags': U(1)}
            profile = PendingProfile(self, cleaned)
            request = {'action':'connect', 'ssid':ssid, 'security': {'none':'open','wpa-psk':'wpa2','sae':'wpa3'}[key]}
            def failed(exc):
                if profile.path in self.objects: profile.remove()
                fail(exc)
            def start(password=''):
                if password: request['password'] = str(password)
                self.connect(request, profile, lambda ac: done(O(profile.path), ac), failed)
            if key == 'none' or security.get('psk'):
                start(security.get('psk', ''))
                return
            agents = list(self.agent.agents.items())
            if not agents:
                failed(error('No desktop password agent is registered', 'AgentManager.NoSecrets'))
                return
            def try_agent(index=0):
                if index >= len(agents):
                    failed(error('No Wi-Fi password was provided', 'AgentManager.NoSecrets'))
                    return
                sender, agent = agents[index]
                def secrets_received(secrets):
                    password = secrets.get('802-11-wireless-security', {}).get('psk')
                    if password: start(password)
                    else: failed(error('Password was not provided', 'AgentManager.NoSecrets'))
                def agent_failed(exc):
                    if exc.get_dbus_name().endswith('UserCanceled'): failed(error('Connection canceled', 'AgentManager.UserCanceled'))
                    else:
                        self.agent.agents.pop(sender, None)
                        try_agent(index+1)
                agent.GetSecrets(cleaned, O(profile.path), '802-11-wireless-security', dbus.Array([],signature='s'), U(5),
                                 dbus_interface=NM+'.SecretAgent', reply_handler=secrets_received, error_handler=agent_failed, timeout=120)
            try_agent()
        except Exception as exc: fail(exc)

    def set_active(self, profile, state):
        if self.active_path == '/':
            self.active_path = BASE + '/ActiveConnection/1'
            settings = profile.settings()['connection']
            Object(self, self.active_path, {ACTIVE: {
                'Connection': O(profile.path), 'SpecificObject': O('/'), 'Id': settings['id'],
                'Uuid': settings['uuid'], 'Type': S('802-11-wireless'), 'Devices': paths([DEV]),
                'State': U(state), 'StateFlags': U(0), 'Default': B(False), 'Default6': B(False),
                'Ip4Config': O('/'), 'Ip6Config': O('/'), 'Dhcp4Config': O('/'), 'Dhcp6Config': O('/'),
                'Vpn': B(False), 'Master': O('/'),
            }})
        self.objects[self.active_path].update(ACTIVE, {'State': U(state)})
        self.device.update(DEVICE, {'ActiveConnection': O(self.active_path)})
        self.update_root()

    def clear_active(self):
        if self.active_path != '/':
            self.objects[self.active_path].update(ACTIVE, {'State': U(4)})
            self.objects[self.active_path].remove()
        self.active_path, self.active_profile = '/', None
        self.pending = None
        self.device.update(DEVICE, {'ActiveConnection': O('/')})
        self.update_root()

    def update_root(self):
        """Active and primary connections across Wi-Fi and mobile data. Wi-Fi
        is primary while connected, as on Android."""
        wifi_state = 0
        if self.active_path != '/':
            wifi_state = int(self.objects[self.active_path].interfaces[ACTIVE]['State'])
        active = [self.active_path] if self.active_path != '/' else []
        if self.mobile_active:
            active.append(MOBILE_ACTIVE)
        if wifi_state == 2:
            primary, kind = self.active_path, '802-11-wireless'
        elif self.mobile_active:
            primary, kind = MOBILE_ACTIVE, 'gsm'
        else:
            primary, kind = '/', ''
        self.root.update(NM, {'ActiveConnections': paths(active), 'PrimaryConnection': O(primary),
                              'PrimaryConnectionType': S(kind),
                              'ActivatingConnection': O(self.active_path if wifi_state == 1 else '/')})
        for path in active:
            self.objects[path].update(ACTIVE, {'Default': B(path == primary)})

    def refresh_mobile(self, data):
        mobile = data.get('mobile', {})
        cellular = [n for n in data['networks'] if n.get('cellular') and not n.get('vpn') and n.get('internet')]
        sim_ready = bool(mobile.get('simReady'))
        data_enabled = bool(mobile.get('dataEnabled'))
        connected = sim_ready and data_enabled and bool(cellular)
        interface = next((n['interface'] for n in cellular if n.get('validated')),
                         cellular[0]['interface'] if cellular else 'rmnet')
        operator = mobile.get('operatorName') or ''
        self.mobile_profile.name = operator or '移动数据'

        if connected and not self.mobile_active:
            settings = self.mobile_profile.settings()['connection']
            self.mobile_active = Object(self, MOBILE_ACTIVE, {ACTIVE: {
                'Connection': O(MOBILE_PROFILE), 'SpecificObject': O('/'), 'Id': settings['id'],
                'Uuid': settings['uuid'], 'Type': S('gsm'), 'Devices': paths([MODEM_DEV]),
                'State': U(2), 'StateFlags': U(0), 'Default': B(False), 'Default6': B(False),
                'Ip4Config': O('/'), 'Ip6Config': O('/'), 'Dhcp4Config': O('/'), 'Dhcp6Config': O('/'),
                'Vpn': B(False), 'Master': O('/'),
            }})
        elif not connected and self.mobile_active:
            self.mobile_active.update(ACTIVE, {'State': U(4)})
            self.mobile_active.remove()
            self.mobile_active = None
        if self.mobile_active:
            self.mobile_active.update(ACTIVE, {'Id': S(self.mobile_profile.name)})

        state = 100 if connected else (30 if sim_ready and data_enabled else 20)
        previous = int(self.modem_device.interfaces[DEVICE]['State'])
        self.modem_device.update(DEVICE, {'State': U(state), 'StateReason': dbus.Struct((U(state), U(0))),
                                          'Interface': S(interface), 'IpInterface': S(interface if connected else ''),
                                          'ActiveConnection': O(MOBILE_ACTIVE if connected else '/')})
        self.modem_device.update(NM_MODEM, {'OperatorCode': S(mobile.get('operatorCode') or '')})
        if state != previous:
            self.modem_device.StateChanged(U(state), U(previous), U(0))
        self.root.update(NM, {'WwanEnabled': B(data_enabled), 'WwanHardwareEnabled': B(sim_ready)})

        level = max(0, min(4, int(mobile.get('signalLevel') or 0)))
        registered = sim_ready and bool(operator)
        self.modem.update(MM_MODEM, {
            'State': dbus.Int32(11 if connected else (8 if registered else 3)),
            'AccessTechnologies': U(ACCESS_TECHNOLOGIES.get(int(mobile.get('networkType') or 0), 0)),
            'SignalQuality': dbus.Struct((U(level * 25), B(sim_ready)), signature='ub'),
        })
        self.modem.update(MM_3GPP, {'OperatorName': S(operator), 'OperatorCode': S(mobile.get('operatorCode') or ''),
                                    'RegistrationState': U(1 if registered else 0)})

    def refresh_bluetooth(self, data):
        bt = data.get('bluetooth', {})
        state = int(bt.get('state', 10))   # Android: 10 off, 11 turning on, 12 on, 13 turning off
        name = bt.get('name') or 'Android'
        self.adapter.update(ADAPTER, {
            'Address': S(bt.get('address') or '00:00:00:00:00:00'), 'Name': S(name), 'Alias': S(name),
            'Powered': B(state == 12),
            'PowerState': S({11: 'off-enabling', 12: 'on', 13: 'on-disabling'}.get(state, 'off')),
        })
        seen = set()
        for entry in bt.get('devices', []):
            path = bluetooth_path(entry['address'])
            device = self.bt_devices.get(path)
            if device is None:
                device = self.bt_devices[path] = BluetoothDevice(self, entry['address'])
            device.refresh(entry)
            seen.add(path)
        for path in list(self.bt_devices):
            if path not in seen:
                self.bt_devices.pop(path).remove()

    def refresh(self, data):
        self.snapshot = data
        enabled, current = data['wifiEnabled'], data['current']
        seen = set()
        for ap in data['accessPoints']:
            if not ap.get('ssid') or not ap.get('bssid'): continue
            obj = next((o for o in self.aps.values() if o.ap['bssid'] == ap['bssid']), None)
            if obj is None:
                obj = AccessPoint(self, ap)
                self.aps[obj.path] = obj
                self.device.AccessPointAdded(O(obj.path))
            else: obj.refresh(ap)
            seen.add(obj.path)
        for path in list(self.aps):
            if path not in seen:
                self.device.AccessPointRemoved(O(path))
                self.aps.pop(path).remove()
        existing = set()
        for p in data['profiles']:
            path = BASE + '/Settings/' + str(p['networkId'] + 1)
            if path not in self.profiles:
                self.profiles[path] = Profile(self, p)
                self.settings.NewConnection(O(path))
            else: self.profiles[path].profile = p
            existing.add(path)
        for path in list(self.profiles):
            if path not in existing: self.profiles.pop(path).remove()
        self.settings.update(SETTINGS, {'Connections': paths(self.profiles)})
        connected = enabled and current.get('state') == 'COMPLETED' and current.get('networkId', -1) >= 0
        target_connected = connected and (not self.pending or current.get('ssid') == self.pending)
        activating = self.pending is not None and time.monotonic() - self.activation_started < 45 and not target_connected
        if activating: connected = False
        state = 100 if connected else (40 if activating else (30 if enabled else 20))
        previous = int(self.device.interfaces[DEVICE]['State'])
        if connected:
            p = next((p for p in self.profiles.values() if p.profile['networkId'] == current['networkId']), None)
            if p:
                if self.active_profile and self.active_profile.path != p.path: self.clear_active()
                self.active_profile = p
                self.pending = None
                self.set_active(p, 2)
        elif not activating: self.clear_active()
        self.device.update(DEVICE, {'State': U(state), 'StateReason': dbus.Struct((U(state), U(0))),
                                    'AvailableConnections': paths(self.profiles)})
        if state != previous: self.device.StateChanged(U(state), U(previous), U(0))
        active_ap = next((o.path for o in self.aps.values() if o.ap['bssid'] == current.get('bssid')), '/')
        self.device.update(WIRE, {'AccessPoints': paths(self.aps), 'ActiveAccessPoint': O(active_ap if connected else '/'),
                                  'Bitrate': U(max(0, current.get('linkSpeed', 0)) * 1000),
                                  'LastScan': dbus.Int64(max((ap.get('timestamp', 0) // 1000 for ap in data['accessPoints']), default=-1))})
        self.refresh_mobile(data)
        self.refresh_bluetooth(data)
        self.radios.update(RADIOS, {'AirplaneMode': B(bool(data.get('airplane')))})
        self.update_root()
        validated = any(n['validated'] for n in data['networks'])
        connected = connected or self.mobile_active is not None
        global_state = 70 if validated else (50 if connected else (40 if activating else 20))
        old_global = self.root.interfaces[NM]['State']
        self.root.update(NM, {'WirelessEnabled': B(enabled), 'State': U(global_state), 'Connectivity': U(4 if validated else 1)})
        if old_global != global_state: self.root.StateChanged(U(global_state))

if __name__ == '__main__':
    DBusGMainLoop(set_as_default=True)
    agent_process = None
    try:
        try: android({'action':'snapshot'})
        except (OSError, ValueError):
            def android_root():
                rootfd = os.open('/proc/1/root', os.O_RDONLY | os.O_DIRECTORY)
                with open('/proc/1/ns/mnt', 'rb') as namespace:
                    os.setns(namespace.fileno(), 0)
                os.fchdir(rootfd)
                os.chroot('.')
                os.close(rootfd)
                os.chdir('/')
            android_env = {'CLASSPATH':'/data/local/ubuntu26/bridge/native-network-agent.jar', 'PATH':'/system/bin',
                           'ANDROID_DATA':'/data', 'ANDROID_ROOT':'/system'}
            # ART needs the boot class path configured by Android init. Import only
            # runtime paths from zygote, never arbitrary desktop or secret variables.
            for proc in pathlib.Path('/proc').iterdir():
                if not proc.name.isdigit(): continue
                try:
                    with (proc/'cmdline').open('rb') as command:
                        if command.read(16).split(b'\0',1)[0] != b'zygote64': continue
                    for entry in (proc/'environ').read_bytes().split(b'\0'):
                        key, separator, value = entry.partition(b'=')
                        name = key.decode(errors='replace')
                        if separator and (name.startswith('ANDROID_') or name in ('BOOTCLASSPATH','DEX2OATBOOTCLASSPATH','SYSTEMSERVERCLASSPATH')):
                            if not name.startswith('ANDROID_SOCKET_'): android_env[name] = value.decode()
                    break
                except OSError: continue
            if 'BOOTCLASSPATH' not in android_env:
                raise RuntimeError('Android zygote runtime environment was not found')
            agent_process = subprocess.Popen(['/system/bin/app_process', '/system/bin', 'local.ubuntu26.connectivity.NetAgent'],
                env=android_env, preexec_fn=android_root, stdin=subprocess.DEVNULL,
                stdout=None, stderr=None)
            for attempt in range(40):
                try:
                    android({'action':'snapshot'})
                    break
                except (OSError, ValueError): time.sleep(.2)
            else: raise RuntimeError('Android connectivity agent did not start; exit=' + str(agent_process.poll()))
        service = Service()
        loop = GLib.MainLoop()
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (loop.quit(), False)[1])
        loop.run()
    finally:
        if agent_process:
            agent_process.terminate()
            try: agent_process.wait(timeout=5)
            except subprocess.TimeoutExpired: agent_process.kill()
