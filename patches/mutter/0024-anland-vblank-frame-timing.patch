 static void
+clear_pending_fence (MetaBackendAnland *backend)
+{
+  if (backend->pending_fence_fd >= 0)
+    close (backend->pending_fence_fd);
+  backend->pending_fence_fd = -1;
+}
+
+/* When the render fence signaled, or 0 if it has not yet. */
+static int64_t
+get_fence_signal_time_us (int fence_fd)
+{
+  struct sync_fence_info fences[8];
+  struct sync_file_info info = { 0 };
+  int64_t signal_time_ns = 0;
+
+  if (ioctl (fence_fd, SYNC_IOC_FILE_INFO, &info) < 0 ||
+      info.status != 1 || info.num_fences == 0)
+    return 0;
+
+  info = (struct sync_file_info) {
+    .num_fences = MIN (info.num_fences, G_N_ELEMENTS (fences)),
+    .sync_fence_info = (uintptr_t) fences,
+  };
+  if (ioctl (fence_fd, SYNC_IOC_FILE_INFO, &info) < 0)
+    return 0;
+
+  for (uint32_t i = 0; i < info.num_fences; i++)
+    signal_time_ns = MAX (signal_time_ns, (int64_t) fences[i].timestamp_ns);
+
+  return signal_time_ns / 1000;
+}
+
+/* The first panel vblank at or after `ready_time_us`. */
+static gboolean
+get_vblank_after (MetaBackendAnland *backend,
+                  int64_t            ready_time_us,
+                  float              refresh_rate,
+                  int64_t           *vblank_time_us)
+{
+  drmVBlank vblank = {
+    .request.type = DRM_VBLANK_RELATIVE,
+    .request.sequence = 0,
+  };
+  int64_t interval_us;
+  int64_t time_us;
+
+  if (backend->vblank_fd < 0 || refresh_rate <= 0.0f ||
+      drmWaitVBlank (backend->vblank_fd, &vblank) != 0)
+    return FALSE;
+
+  interval_us = (int64_t) (G_USEC_PER_SEC / refresh_rate);
+  time_us = vblank.reply.tval_sec * G_USEC_PER_SEC + vblank.reply.tval_usec;
+  if (time_us < ready_time_us)
+    time_us += (ready_time_us - time_us + interval_us - 1) / interval_us * interval_us;
+
+  *vblank_time_us = time_us;
+  return TRUE;
+}
