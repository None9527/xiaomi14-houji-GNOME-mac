+static void
 complete_pending_frame (MetaBackendAnland *backend)
 {
   ClutterFrameInfo frame_info;
+  int64_t now_us = g_get_monotonic_time ();
+  int64_t ready_time_us;
+  int64_t vblank_time_us;
+  float refresh_rate;
 
   if (!backend->stage_view || !backend->frame_pending)
     return;
 
+  /* The frame can be shown once it is submitted and rendered; a fence that
+   * has not signaled yet makes "now" the best lower bound. */
+  ready_time_us = now_us;
+  if (backend->pending_fence_fd >= 0)
+    {
+      int64_t signal_time_us = get_fence_signal_time_us (backend->pending_fence_fd);
+
+      if (signal_time_us > 0)
+        ready_time_us = MAX (signal_time_us, backend->pending_submit_time_us);
+    }
+  clear_pending_fence (backend);
+
+  refresh_rate = clutter_stage_view_get_refresh_rate (
+    CLUTTER_STAGE_VIEW (backend->stage_view));
   frame_info = (ClutterFrameInfo) {
     .global_frame_counter = backend->pending_global_frame_counter,
     .view_frame_counter = backend->pending_view_frame_counter,
-    .refresh_rate = clutter_stage_view_get_refresh_rate (
-      CLUTTER_STAGE_VIEW (backend->stage_view)),
-    .presentation_time = g_get_monotonic_time (),
+    .refresh_rate = refresh_rate,
+    .presentation_time = now_us,
     .flags = CLUTTER_FRAME_INFO_FLAG_NONE,
     .sequence = ++backend->presentation_sequence,
   };
+
+  /* Reporting the panel's vblank lets the frame clock schedule updates in
+   * phase with it, instead of on a free-running timer. */
+  if (get_vblank_after (backend, ready_time_us, refresh_rate, &vblank_time_us))
+    {
+      frame_info.presentation_time = vblank_time_us;
+      frame_info.flags = CLUTTER_FRAME_INFO_FLAG_VSYNC |
+                         CLUTTER_FRAME_INFO_FLAG_HW_CLOCK;
+      frame_info.kms_ready_time_us = ready_time_us;
+    }
+
   clutter_stage_view_notify_presented (CLUTTER_STAGE_VIEW (backend->stage_view),
                                        &frame_info);
   backend->frame_pending = FALSE;
