+void
+meta_screen_cast_virtual_stream_set_monitor_identity (MetaScreenCastVirtualStream *virtual_stream,
+                                                      const char                  *vendor,
+                                                      const char                  *product,
+                                                      const char                  *serial)
+{
+  g_set_str (&virtual_stream->vendor, vendor);
+  g_set_str (&virtual_stream->product, product);
+  g_set_str (&virtual_stream->serial, serial);
+}
+
+gboolean
+meta_screen_cast_virtual_stream_get_monitor_identity (MetaScreenCastVirtualStream  *virtual_stream,
+                                                      const char                  **vendor,
+                                                      const char                  **product,
+                                                      const char                  **serial)
+{
+  if (!virtual_stream->vendor || !virtual_stream->product || !virtual_stream->serial)
+    return FALSE;
+
+  *vendor = virtual_stream->vendor;
+  *product = virtual_stream->product;
+  *serial = virtual_stream->serial;
+  return TRUE;
+}
