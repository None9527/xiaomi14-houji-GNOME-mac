+static MetaVirtualMonitorInfo *
+create_monitor_info (MetaScreenCastVirtualStreamSrc *virtual_src,
+                     GList                          *mode_infos)
+{
+  MetaScreenCastStreamSrc *src = META_SCREEN_CAST_STREAM_SRC (virtual_src);
+  MetaScreenCastVirtualStream *virtual_stream =
+    META_SCREEN_CAST_VIRTUAL_STREAM (meta_screen_cast_stream_src_get_stream (src));
+  const char *vendor, *product, *serial;
+  g_autofree char *generated_serial = NULL;
+
+  if (meta_screen_cast_virtual_stream_get_monitor_identity (virtual_stream,
+                                                            &vendor, &product,
+                                                            &serial))
+    return meta_virtual_monitor_info_new (vendor, product, serial, mode_infos);
+
+  generated_serial = generate_next_virtual_monitor_serial ();
+  return meta_virtual_monitor_info_new ("MetaVendor",
+                                        "Virtual remote monitor",
+                                        generated_serial,
+                                        mode_infos);
+}
