+/**
+ * meta_stage_view_set_external_buffer_age:
+ * @view: a #MetaStageView
+ * @age: age of the framebuffer the next frame renders into, 0 if its
+ *   contents are undefined, or -1 to stop tracking buffer age
+ *
+ * For backends that cycle through their own (non-onscreen) render targets.
+ * With an age set, the stage repairs only the damage the target missed,
+ * exactly like for an onscreen with EGL_EXT_buffer_age.
+ */
+void
+meta_stage_view_set_external_buffer_age (MetaStageView *view,
+                                         int            age)
+{
+  MetaStageViewPrivate *priv =
+    meta_stage_view_get_instance_private (view);
+
+  priv->external_buffer_age = age;
+}
+
+gboolean
+meta_stage_view_get_external_buffer_age (MetaStageView *view,
+                                         int           *age)
+{
+  MetaStageViewPrivate *priv =
+    meta_stage_view_get_instance_private (view);
+
+  if (priv->external_buffer_age < 0)
+    return FALSE;
+
+  *age = priv->external_buffer_age;
+  return TRUE;
+}
