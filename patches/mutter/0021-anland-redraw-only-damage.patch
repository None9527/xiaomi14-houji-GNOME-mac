+static void
+reset_buffer_ages (MetaBackendAnland *backend)
+{
+  backend->paint_sequence = 0;
+  memset (backend->buffer_painted_at, 0, sizeof backend->buffer_painted_at);
+  backend->needs_full_redraw = TRUE;
+
+  if (backend->stage_view)
+    meta_stage_view_set_external_buffer_age (backend->stage_view, 0);
+}
+
+static void
+update_buffer_age (MetaBackendAnland *backend)
+{
+  int buffer = backend->current_buffer;
+  int age = 0;
+
+  if (buffer >= 0 && backend->buffer_painted_at[buffer] > 0)
+    age = backend->paint_sequence - backend->buffer_painted_at[buffer] + 1;
+
+  meta_stage_view_set_external_buffer_age (backend->stage_view, age);
+}
