+
+/* The scale for the panel's mode: the one in use when the panel already
+ * shows something (it rotated, so keep what the user sees), otherwise one
+ * that keeps the short side near 600 logical pixels, as phones do. */
+static float
+get_preferred_scale (MetaBackendAnland *backend)
+{
+  int short_side = MIN (backend->screen_info.width, backend->screen_info.height);
+
+  if (backend->virtual_monitor)
+    {
+      MetaOutput *output = meta_virtual_monitor_get_output (backend->virtual_monitor);
+      MetaMonitor *monitor = output ? meta_output_get_monitor (output) : NULL;
+      MetaLogicalMonitor *logical_monitor =
+        monitor ? meta_monitor_get_logical_monitor (monitor) : NULL;
+
+      if (logical_monitor)
+        return meta_logical_monitor_get_scale (logical_monitor);
+    }
+
+  return CLAMP (roundf (short_side / 600.0f), 1.0f, 4.0f);
 }
 
