+/* Writes non-context registers with CP_NON_CONTEXT_REG_BUNCH, the way
+ * freedreno does on A7XX.
+ */
+static void
+tu7_emit_non_context_regs(struct tu_cs *cs, const uint32_t (*regs)[2], unsigned count)
+{
+   tu_cs_emit_pkt7(cs, CP_NON_CONTEXT_REG_BUNCH, 2 + count * 2);
+   tu_cs_emit(cs, 1);
+   tu_cs_emit(cs, 0);
+   for (unsigned i = 0; i < count; i++) {
+      tu_cs_emit(cs, regs[i][0]);
+      tu_cs_emit(cs, regs[i][1]);
+   }
+}
